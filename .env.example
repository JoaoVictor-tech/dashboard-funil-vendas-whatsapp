# Monitor de Funil
# Copie para .env e preencha. Arquivo com segredos: nao versionar.

# --- Banco (o docker-compose sobe um Postgres com estes dados) --------------------------
DATABASE_URL=postgresql+asyncpg://monitor:monitor@db:5432/monitor

# --- Modo demonstracao ------------------------------------------------------------------
# true = sem APIs externas; popule com: docker compose exec api python -m app.cli demo
MODO_DEMO=true

# --- Helena (plataforma de atendimento) - uma conta por unidade -------------------------
# Token: Ajustes > Integracoes > Integracao via API, na conta de cada loja.
HELENA_BASE_URL=https://api.helena.run
HELENA_TOKEN_CENTRO=
HELENA_TOKEN_NORTE=

# --- Reportei (token da API v2) - IDs das integracoes por unidade -----------------------
REPORTEI_TOKEN=
REPORTEI_META_CENTRO=
REPORTEI_GOOGLE_CENTRO=
REPORTEI_META_NORTE=
REPORTEI_GOOGLE_NORTE=

# --- Coletor ----------------------------------------------------------------------------
BACKFILL_INICIO=2026-06-01
COLETA_INTERVALO_MIN=60
MIDIA_REBAIXAR_DIAS=7
SCHEDULER_ATIVO=true

# --- Dashboard (HTTP Basic) -------------------------------------------------------------
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=troque-esta-senha
EMPRESA_NOME=Auto Vale
DASHBOARD_TITULO=Auto Vale · Monitor de Funil
CAMPANHA_PREFIXO=AutoVale_

LOG_LEVEL=INFO
